# Resend API klíč — získáš na resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email pro příjem zpráv z kontaktního formuláře
CONTACT_EMAIL=sobotkakrystof5@gmail.com

# --- Volitelné: custom sender adresy (po ověření vlastní domény na Resend) ---
# Bez nastavení se používá fallback "onboarding@resend.dev" (Resend free sandbox,
# má rate-limit a může být v budoucnu omezený). Pro produkci je doporučeno
# ověřit doménu vizeon.cz v Resend dashboardu (Domains → Add Domain) a
# nastavit níže uvedené proměnné.
#
# Display name MUSÍ být ASCII (sanitizer odstraňuje diakritiku/em-dash).
# Formát: "Display Name <addr@domena.cz>"
#
# RESEND_BOOKING_FROM="VIZEON Booking <booking@vizeon.cz>"
# RESEND_BOOKING_CONFIRM_FROM="Krystof Sobotka - VIZEON <hello@vizeon.cz>"
# RESEND_CONTACT_FROM="VIZEON Kontakt <kontakt@vizeon.cz>"

# ── Integrace s ZakazIQ (app/api/booking → přehled zakázek) ─────────────────

# API klíč pro ZakazIQ — musí být stejný jako VIZEON_API_KEY nastavený v ZakazIQ.
# Bez něj /api/booking vrátí 500 a rezervaci nepůjde odeslat.
ZAKAZIQ_API_KEY=
