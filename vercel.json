{
  "regions": ["fra1"],
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.vizeon.cz" }],
      "destination": "https://vizeon.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.vizeon.cz" }],
      "destination": "https://vizeon.cz/:path*",
      "permanent": true
    }
  ]
}
